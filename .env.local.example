# Supabase 프로젝트 생성 후 Project Settings > API 에서 값을 복사해 .env.local 에 붙여넣으세요.
# 값이 비어있으면 앱은 자동으로 브라우저 localStorage를 이용한 mock 모드로 동작합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Toss Payments 가맹점 가입 후 발급받은 클라이언트 키. 비어있으면 카드/카카오페이도
# 무통장입금처럼 관리자가 수동으로 입금 확인하는 방식으로 동작합니다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# 스마트택배(SweetTracker, tracking.sweettracker.co.kr) 조회 API 키. 서버(app/api/tracking)에서만
# 쓰이므로 NEXT_PUBLIC_ 접두사를 붙이지 않습니다. 비어있으면 고객의 "배송조회" 버튼이 대신
# 택배사 공식 조회 페이지를 새 창으로 엽니다.
SWEETTRACKER_API_KEY=

# 웹 푸시(Web Push) VAPID 키쌍. `npx web-push generate-vapid-keys`로 새로 생성하거나
# 대화에서 안내받은 값을 그대로 쓰세요. PUBLIC은 브라우저 구독에 쓰여 NEXT_PUBLIC_이
# 필요하고, PRIVATE은 서버 서명 전용이라 절대 NEXT_PUBLIC_을 붙이면 안 됩니다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Supabase 서비스 롤 키(Project Settings > API > service_role) — 웹 푸시 발송 API가
# RLS를 우회해서 모든 회원의 구독 정보를 읽어야 해서 필요합니다. 매우 민감한 키라
# 절대 NEXT_PUBLIC_을 붙이거나 브라우저로 전달하면 안 됩니다.
SUPABASE_SERVICE_ROLE_KEY=
