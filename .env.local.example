# Supabase 프로젝트 생성 후 Project Settings > API 에서 값을 복사해 .env.local 에 붙여넣으세요.
# 값이 비어있으면 앱은 자동으로 브라우저 localStorage를 이용한 mock 모드로 동작합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Toss Payments 가맹점 가입 후 발급받은 클라이언트 키. 비어있으면 카드/카카오페이도
# 무통장입금처럼 관리자가 수동으로 입금 확인하는 방식으로 동작합니다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# 스마트택배(SweetTracker, tracking.sweettracker.co.kr) 조회 API 키. 서버(app/api/tracking)에서만
# 쓰이므로 NEXT_PUBLIC_ 접두사를 붙이지 않습니다. 비어있으면 고객의 "배송조회" 버튼이 대신
# 택배사 공식 조회 페이지를 새 창으로 엽니다.
SWEETTRACKER_API_KEY=
